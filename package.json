{
  "name": "nakomponents",
  "version": "0.1.0",
  "description": "Shared UI primitives, near-black theme tokens, and lint preset for QuillDev web apps.",
  "type": "module",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./oxlint.json": "./oxlint.json"
  },
  "files": [
    "dist",
    "oxlint.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json --emitDeclarationOnly && bun -e 'const fs = require(\"fs\"); const src = fs.readFileSync(\"src/theme.css\", \"utf8\"); fs.writeFileSync(\"dist/theme.css\", \"@source \\\"./index.js\\\";\\n\" + src);'",
    "build:preview": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.lib.json",
    "lint": "oxlint --deny-warnings",
    "doctor": "react-doctor --yes --blocking warning",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run doctor && bun test"
  },
  "peerDependencies": {
    "lucide-react": ">=0.500.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.61.0",
    "oxlint": "^1.80.0",
    "oxlint-plugin-react-doctor": "latest",
    "react": "^19.3.1",
    "react-doctor": "latest",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
